# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.pyd

# Distribution / packaging
build/
dist/
*.egg-info/

# Virtual environments
mediapipe_env/
venv/
.venv/
ENV/

# IDEs and editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Devcontainer build artifacts
.devcontainer/.dockerignore
.devcontainer/docker-compose.yml

# OS files
.DS_Store
Thumbs.db

# Logs and temp files
*.log
*.tmp
*.cache

# Runs / experiments
runs/
wandb/

# Data: keep data directory structure, ignore large files
# Model weights are NOT tracked by git but should persist in codespace
# Users must download models separately or use download scripts
data/models/*.pt
data/models/*.task
!data/models/.gitkeep
!data/models/README.md

# Ignore large input and output directories
!data/input/.gitkeep
!data/input/README.md
data/output/*
!data/output/.gitkeep
!data/output/README.md

# Media files (but allow input video to be tracked)
*.avi
*.mov
*.webm
# Note: .mp4 files in data/input/ are tracked for pipeline testing

# Jupyter
.ipynb_checkpoints
*.ipynb
!setup_and_run.ipynb

# Testing
.pytest_cache/
.coverage
htmlcov/

# Keep gitkeep placeholders
!data/models/.gitkeep
!data/input/.gitkeep
!data/output/.gitkeep
