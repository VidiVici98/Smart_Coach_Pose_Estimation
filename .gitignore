# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.pyd

# Distribution / packaging
build/
dist/
*.egg-info/

# Virtual environments
mediapipe_env/
venv/
.venv/
ENV/

# IDEs and editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db

# Logs and temp files
*.log
*.tmp
*.cache

# Runs / experiments
runs/
wandb/

# Data: keep models versioned, ignore large inputs/outputs
# We want to keep `data/models/` in git (per project decision)
data/models/**
!data/models/.gitkeep

# Ignore large input and output directories
data/input/*
data/output/*

# Media
*.mp4
*.avi
*.mov
*.webm

# MediaPipe / task files (if you want to ignore some, keep models tracked above)
*.task

# Jupyter
.ipynb_checkpoints
*.ipynb

# Testing
.pytest_cache/
.coverage
htmlcov/

# Keep gitkeep placeholders
!data/models/.gitkeep
!data/input/.gitkeep
!data/output/.gitkeep
