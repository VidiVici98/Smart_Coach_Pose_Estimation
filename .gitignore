# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.pyd

# Distribution / packaging
build/
dist/
*.egg-info/

# Virtual environments
mediapipe_env/
venv/
.venv/
ENV/

# IDEs and editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db

# Logs and temp files
*.log
*.tmp
*.cache

# Runs / experiments
runs/
wandb/

# Data: keep data directory structure, ignore large files
# Model weights are NOT tracked - only directory structure and README
data/models/**
!data/models/.gitkeep
!data/models/README.md

# Ignore large input and output directories
data/input/*
!data/input/.gitkeep
!data/input/README.md
data/output/*
!data/output/.gitkeep
!data/output/README.md

# Media
*.mp4
*.avi
*.mov
*.webm

# MediaPipe / task files (if you want to ignore some, keep models tracked above)
*.task

# Jupyter
.ipynb_checkpoints
*.ipynb
!setup_and_run.ipynb

# Testing
.pytest_cache/
.coverage
htmlcov/

# Keep gitkeep placeholders
!data/models/.gitkeep
!data/input/.gitkeep
!data/output/.gitkeep
